{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmodelweights.com/registry.schema.json",
  "title": "Open Model Weights Registry v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "models"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "verification_levels": {
      "type": "object"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "developer",
          "model",
          "weights",
          "license",
          "hardware",
          "lineage",
          "training_assets",
          "sources",
          "verification"
        ]
      }
    }
  }
}